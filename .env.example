# All optional. vibecheck runs fully without any env vars.

# A free Google PageSpeed Insights API key enables the Lighthouse scan
# (performance / SEO / accessibility / best-practices). Without it, every other
# scan still works — Lighthouse just returns no data.
# Get one (2 min): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Your canonical site URL, used for absolute OG-image links in shared results.
# On Vercel, VERCEL_URL is used automatically if this is unset — only set this
# once you have a custom domain (e.g. https://vibecheck.dev).
NEXT_PUBLIC_SITE_URL=

# An Upstash Redis store powers the anonymous public counter on the homepage
# ("N apps checked · X% were leaking"). It stores ONLY three integer counters —
# never a URL, host, key, or preview. Without it the counter is hidden and the
# "add to the tally" button doesn't appear. Add "Upstash" from the Vercel
# Marketplace and it sets these automatically (UPSTASH_REDIS_REST_* also work).
KV_REST_API_URL=
KV_REST_API_TOKEN=
